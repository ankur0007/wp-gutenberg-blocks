{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"types": [ "react", "react-dom" ]
	},
	"include": [ "src/**/*" ],
	"exclude": [ "node_modules", "build" ]
}
