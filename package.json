{
	"name": "avcl-blocks",
	"version": "0.1.0",
	"description": "A collection of custom Gutenberg blocks.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"typecheck": "tsc --noEmit",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --blocks-manifest",
		"build:admin": "wp-scripts build --source-path=src/admin --output-path=build/admin",
		"start:admin": "wp-scripts start --source-path=src/admin --output-path=build/admin"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/block-editor": "latest",
		"@wordpress/blocks": "latest",
		"@wordpress/components": "^42.0.0",
		"@wordpress/core-data": "^8.2.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/editor": "^16.0.0",
		"@wordpress/i18n": "latest"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/wordpress__block-editor": "^15.0.7",
		"@wordpress/scripts": "^36.1.0",
		"typescript": "^6.0.3"
	}
}
